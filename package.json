{
  "name": "vite-plugin-hyperapp",
  "version": "2.1.0",
  "type": "module",
  "description": "Plugin and helpers for using Hyperapp with Vite",
  "author": "Zacharias Enochsson",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.js"
    },
    "./jsx/jsx-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "import": "./dist/jsx/jsx-runtime.js"
    },
    "./jsx/jsx-dev-runtime": {
      "types": "./dist/jsx/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx/jsx-dev-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "hyperapp-jsx": "^1.0.0",
    "hyperapp-ssr": "^1.0.0",
    "magic-string": "^1.4.3"
  },
  "peerDependencies": {
    "hyperapp": "^2.0.22",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "hyperapp": "^2.0.22",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaceno/vite-plugin-hyperapp.git"
  },
  "bugs": {
    "url": "https://github.com/zaceno/vite-plugin-hyperapp/issues"
  },
  "homepage": "https://github.com/zaceno/vite-plugin-hyperapp#readme"
}
