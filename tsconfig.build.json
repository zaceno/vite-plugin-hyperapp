{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "allowJs": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "rewriteRelativeImportExtensions": true,
    "noUnusedLocals": true
  },
  "include": ["index.ts", "jsx/**/*.ts", "hmr/**/*.ts", "hmr/**/*.js", "safari-sourcemaps/**/*.ts", "ssr/**/*.ts"],
  "exclude": ["dist", "tests"]
}
